{
  "functions": {
    "api/*.js": {
      "includeFiles": "index.html",
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/api/ingest?asset=logo-48.png"
    },
    {
      "source": "/thank-you",
      "destination": "/thank-you.html"
    },
    {
      "source": "/a/:name",
      "destination": "/api/ingest?asset=:name"
    }
  ]
}